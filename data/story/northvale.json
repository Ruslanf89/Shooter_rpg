 "clues": {
  "grey_wolf": {
   "title": "Grey-Muzzled Wolf",
   "at_kill": "Grey-Muzzled Wolf",
   "flag": "grey_wolf",
   "line": "th_grey_wolf",
   "sound": "pickup_item",
   "text": "Its gums are black. A patch of grey fur runs along the muzzle, coarse and dry, as if it belonged to another animal."
  },
  "grave_1": {
   "title": "Open Grave",
   "sound": "pickup_item",
   "text": "The earth is heaped outward, not inward. The lid lies beside the pit, cracked along one edge."
  },
  "grave_2": {
   "title": "Open Grave",
   "sound": "pickup_item",
   "text": "A family slab, shoved aside. The name is worn smooth, but someone has scratched a fresh mark beneath it."
  },
  "grave_3": {
   "title": "Open Grave",
   "line": "th_open_grave",
   "sound": "pickup_item",
   "text": "Empty. Along the inner edge runs a black residue that looks sticky but is dry to the touch."
  },
  "yard_niche": {
   "title": "Burial Niche",
   "sound": "pickup_item",
   "text": "The vault's niche stands open. Inside, the black residue coats the stone like soot, but it smells of wet earth, not fire."
  },
  "yard_branch": {
   "title": "Broken Branch",
   "sound": "impact_wood",
   "text": "Snapped at shoulder height. The same black smear on the bark, as if something brushed past."
  },
  "yard_prints": {
   "title": "Boot Prints",
   "sound": "pickup_item",
   "text": "Two kinds of sole: a broad heel and a narrow one. They cross the grass and stop at the church wall."
  },
  "yard_mushrooms": {
   "title": "Pale Mushrooms",
   "flag": "found_mushrooms",
   "line": "th_mushrooms",
   "sound": "pickup_item",
   "text": "A cluster of pale mushrooms under the rotten stump. They give off a faint glow, even by day."
  },
  "foreman_shard": {
   "title": "Stone Shard",
   "at_kill": "Kobold Foreman",
   "flag": "foreman_shard",
   "line": "th_shard",
   "sound": "pickup_item",
   "text": "A shard of stone the foreman kept like a treasure. One face is coated in the same grey residue as the graves."
  },
  "black_cloth": {
   "title": "Black Cloth",
   "flag": "black_cloth",
   "line": "th_black_cloth",
   "sound": "pickup_item",
   "text": "A strip of blackened cloth caught on a branch at head height. It is stiff with the same residue."
  },
  "barricade": {
   "title": "Collapsed Gate",
   "sound": "impact_wood",
   "text": "The timber gate fell outward, towards Northvale. Something pushed it from the Darkwood side."
  },
  "vesper_page_1": {
   "title": "Torn Page",
   "text": "A page in a hurried hand: 'Bell again. 3:12. Rope still.' The rest is smudged."
  },
  "vesper_page_2": {
   "title": "Torn Page",
   "text": "A sketch of the oak with an arrow, and a note: 'Signal dies by the church. Always by the church.'"
  },
  "notebook_entries": {
   "title": "VesPer's Notebook",
   "text": "Weather. Food. Drone repairs. Sketches of a glowing mushroom, a riverbank, and a shape that might be a person or a reflection. Then: 'The river flows north here. It should not.' 'The mushrooms only glow after the bell.' 'The old man at the church asked where I came from. I lied.' 'I saw the same light in the water again.' 'If another person arrives, I need to know whether they saw the mushroom too...' The last entry stops mid-sentence."
  },
  "grey_sack": {
   "title": "Grey Wheat",
   "flag": "grey_wheat",
   "text": "This sack is damp, and the wheat inside has gone an unhealthy grey."
  },
  "battery_mark": {
   "title": "Drone Battery",
   "flag": "battery_mark",
   "line": "th_battery",
   "text": "One battery has a marking scratched into its casing, like a date."
  },
  "ledger_entry": {
   "title": "The Captain's Ledger",
   "flag": "read_ledger",
   "text": "Stolen food. Batteries. Iron tools. And one entry: 'One sealed box from the church. Payment received from a traveller. Do not break the seal.' It is dated before you arrived."
  },
  "dark_fragment": {
   "title": "Dark Fragment",
   "flag": "dark_fragment",
   "line": "th_fragment",
   "subtle": false,
   "once": true,
   "sound": "pickup_item",
   "text": "A small sealed fragment of dark metal from the captain's belt, beside a ring of stolen keys. It is colder than it should be."
  },
  "vesper_cloth": {
   "title": "Folded Cloth",
   "flag": "found_cloth",
   "once": true,
   "text": "Under the bedroll: a folded piece of cloth that was once part of ordinary workwear. The stitching is machine-straight."
  },
  "vesper_map": {
   "title": "Hand-drawn Map",
   "flag": "found_map",
   "once": true,
   "text": "A charcoal map of the valley. Some marks follow the roads. Others don't follow anything at all."
  },
  "records": {
   "title": "Church Records",
   "flag": "read_records",
   "once": true,
   "subtle": false,
   "needs": "flag:church_key",
   "needs_text": "The cabinet is locked.",
   "text": "Burial registers in a dozen hands. Between them, a sealed letter, its wax unbroken, addressed to 'whoever keeps the bell after me'. And an older entry in faded ink: 'A traveller came down the north road in a coat of no cloth we know. He spoke of a light in the water. He stayed the winter and was gone by spring.'"
  },
  "prayer_book": {
   "title": "Prayer Book",
   "once": true,
   "text": "A heavy book on the lectern. Several pages are marked with charcoal. One is headed 'Of the dead who refuse their graves'. Someone has underlined the word 'refuse' three times."
  },
  "notice_board": {
   "title": "Notice Board",
   "once": true,
   "text": "MISSING: a traveller in a grey coat, last seen at the Crooked Ladle. Ask Marta. WOLVES: keep children inside after dark. And a charcoal sketch of the bandit camp, with an arrow and the word 'NO'."
  },
  "guard_map": {
   "title": "Map Table",
